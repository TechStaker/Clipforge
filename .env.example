# Server Configuration
PORT=3000

# YouTube Data API v3 Key (Optional - Fallback to public oEmbed is enabled automatically)
YOUTUBE_API_KEY=

# Maximum Upload Size in Megabytes (default: 1024MB / 1GB)
MAX_UPLOAD_SIZE=1024

# Cleanup Interval in Minutes (deletes processed jobs older than this interval)
CLEANUP_INTERVAL=60

# Optional custom FFmpeg/FFprobe binary paths (auto-detected if blank)
FFMPEG_PATH=
FFPROBE_PATH=

